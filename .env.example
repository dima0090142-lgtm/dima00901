# Скопируйте этот файл в .env (или впишите переменные в настройках Amvera)

# Токен бота от @BotFather. НИКОГДА не публикуйте его и не коммитьте в git
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой — команда /myid в боте)
ADMIN_IDS=

# Публичный HTTPS-адрес, где работает приложение, например https://tattoo-kult-dasha.amvera.io
WEBAPP_URL=

# Канал для публикации поста с кнопкой записи: @имя_канала или числовой id (-100...)
CHANNEL_ID=@GameCubeVDK

# Необязательно: ссылка на мини-приложение для кнопки в канале.
# По умолчанию https://t.me/<бот>?startapp=channel (нужно включить Main Mini App в @BotFather)
MINIAPP_LINK=

# Папка для базы данных и фотографий (на Amvera — /data)
DATA_DIR=./data
PORT=8080
TIMEZONE=Asia/Vladivostok
MASTER_NAME=Дарья

# Через сколько минут после начала сеанса спросить «Пришёл ли клиент?»
ARRIVAL_CHECK_MINUTES=30

# Необязательно: прокси, если сервер не может достучаться до api.telegram.org
TELEGRAM_PROXY=

# Необязательно: ИИ-помощник для канала (Claude API, https://console.anthropic.com).
# Без ключа всё работает, идеи для постов берутся из готового списка.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
